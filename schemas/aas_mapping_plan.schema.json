{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AASMappingPlan",
  "type": "object",
  "required": ["asset", "submodels", "model_info"],
  "properties": {
    "asset": {"type": "object"},
    "submodels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["idShort", "properties"],
        "properties": {
          "idShort": {"type": "string"},
          "properties": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "model_info": {"type": "object"}
  }
}
