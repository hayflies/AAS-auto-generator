{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SemanticNode",
  "type": "object",
  "required": [
    "semantic_node_id",
    "name",
    "value",
    "value_type",
    "conceptual_definition",
    "source_description",
    "affordance",
    "confidence"
  ],
  "properties": {
    "semantic_node_id": {"type": "string"},
    "name": {"type": "string"},
    "value": {},
    "unit": {"type": ["string", "null"]},
    "value_type": {"type": "string"},
    "conceptual_definition": {"type": "string"},
    "affordance": {"type": "string"},
    "source_description": {"type": "string"},
    "source_reference": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
